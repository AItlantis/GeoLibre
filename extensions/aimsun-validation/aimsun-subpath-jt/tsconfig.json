{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../_shared/node_modules/@types"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "../_shared/src/virtual.d.ts"
  ]
}
